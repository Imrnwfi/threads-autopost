# ========== Asas ==========
PORT=3000
# Kata laluan untuk log masuk ke web app (WAJIB tukar!)
APP_PASSWORD=tukar-kata-laluan-ini
# Rentetan rawak panjang untuk tandatangan sesi (pilihan, disyorkan)
SESSION_SECRET=
# Zon waktu untuk jadual & autopilot
TZ=Asia/Kuala_Lumpur
# Folder simpanan pangkalan data SQLite
DATA_DIR=./data

# ========== Threads API (Meta) ==========
# Pilihan A: Login dengan butang "Sambung akaun Threads" (OAuth)
THREADS_APP_ID=
THREADS_APP_SECRET=
# Mesti sama dengan "Redirect Callback URL" dalam Meta App Dashboard (mesti HTTPS)
THREADS_REDIRECT_URI=https://domain-anda.com/auth/threads/callback

# Pilihan B: Tampal token terus (boleh juga dibuat dalam halaman Tetapan)
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# ========== AI untuk jana post ==========
# anthropic (Claude) atau openai (mana-mana API serasi OpenAI: OpenAI, Gemini, Groq, OpenRouter...)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Kosongkan untuk guna default (claude-sonnet-5-5 / gpt-4o-mini)
AI_MODEL=

# Jika AI_PROVIDER=openai:
OPENAI_API_KEY=
# Contoh Gemini: https://generativelanguage.googleapis.com/v1beta/openai
# Contoh Groq:   https://api.groq.com/openai/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Gaya default akaun (boleh juga ditetapkan dalam Tetapan)
AI_PERSONA=
